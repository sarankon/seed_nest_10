ENV="dev"

SERVER_PORT=3200
HOST_URL=http://localhost:${SERVER_PORT}


## Report Config (report.config.ts)
# ----- REPORT Path
REPORT_PATH=./public/report
REPORT_URL=/report

# ----- CSV File
CSV_PATH=${REPORT_PATH}/csv/
CSV_URL=${REPORT_URL}/csv/

# ----- XLSX File
XLSX_PATH="${REPORT_PATH}/xlsx/"
XLSX_URL="${REPORT_URL}/xlsx/"

# ----- PDF File
PDF_PATH="${REPORT_PATH}/pdf/"
PDF_URL="${REPORT_URL}/pdf/"